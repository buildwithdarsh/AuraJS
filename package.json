{
  "name": "@buildwithdarsh/aura.js",
  "version": "1.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A lightweight, modular JavaScript framework for client-side web applications",
  "main": "dist/aura.umd.js",
  "module": "dist/aura.esm.js",
  "types": "dist/aura.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && rm -rf example/dist && cp -r dist example/dist",
    "typecheck": "tsc --noEmit",
    "dev": "rollup -c -w"
  },
  "keywords": [
    "framework",
    "spa",
    "routing",
    "state-management",
    "templating",
    "i18n"
  ],
  "author": "Darsh Gupta",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.34.8",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
